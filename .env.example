# ============================================================
# DSATGURU — environment variables (copy to .env.local / set on server)
# Never commit real values. Rotate any secret that was ever exposed.
# ============================================================

# ----- Core (REQUIRED) -----
MONGO_URI=                 # MongoDB connection string, e.g. mongodb+srv://user:pass@cluster/dsatmain
JWT_SECRET=               # Long random string used to sign auth tokens (REQUIRED)
NODE_ENV=production

# ----- App URL -----
NEXT_PUBLIC_API_URL=      # Your live site origin, e.g. https://www.dsatguru.com

# ----- Stripe (payments) -----
STRIPE_SECRET_KEY=                    # sk_live_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=   # pk_live_...

# ----- Email / OTP (nodemailer) -----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=                # e.g. DSATGURU <noreply@dsatguru.com>

# ----- LiveKit (live classes) -----
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_WS_URL=           # wss://your-livekit-host

# ----- AI / OCR (admin question tools) -----
GEMINI_API_KEY=
MATHPIX_APP_ID=
MATHPIX_APP_KEY=

# ----- Optional -----
NEXTAUTH_SECRET=          # falls back to JWT_SECRET if unset
