using Microsoft.AspNetCore.Authorization;
using Microsoft.AspNetCore.Mvc;
using DsatPsatLmsApi.DTOs;
using DsatPsatLmsApi.Services;
using System.Security.Claims;
using Microsoft.EntityFrameworkCore;
using DsatPsatLmsApi.Data;

namespace DsatPsatLmsApi.Controllers;

[ApiController]
[Route("api/admin/[controller]")]
public class CourseController : ControllerBase
{
    private readonly ICourseService _courseService;
    private readonly AppDbContext _context;

    public CourseController(ICourseService courseService, AppDbContext context)
    {
        _courseService = courseService;
        _context = context;
    }

    [HttpGet("with-schedule")]
    [AllowAnonymous]
    public async Task<IActionResult> GetAllWithSchedule()
    {
        var courses = await _context.Courses
            .Include(c => c.Highlights)
            .Include(c => c.Schedules)
            .Include(c => c.FAQs)
            .ToListAsync();

        var result = courses.Select(course => new
        {
            id = course.Id,
            title = course.Title,
            description = course.Description,
            bannerImageUrl = course.BannerImageUrl,
            price = course.Price,
            discountedPrice = course.DiscountedPrice,
            discountPercentage = course.DiscountPercentage,
            stripeProductId = course.StripeProductId,
            stripePriceId = course.StripePriceId,
            createdAt = course.CreatedAt,
            highlights = course.Highlights?.OrderBy(h => h.SequenceOrder).Select(h => new { id = h.Id, text = h.Text, sequenceOrder = h.SequenceOrder }).ToList(),
            schedules = course.Schedules?.Select(s => new { id = s.Id, day = s.Day, time = s.Time }).ToList(),
            faqs = course.FAQs?.Select(f => new { id = f.Id, question = f.Question, answer = f.Answer }).ToList()
        }).ToList();

        return Ok(new { message = "Courses with highlights and schedules", data = result });
    }

    [HttpPost]
    [Authorize(Roles = "Admin")]
    public async Task<IActionResult> Create([FromBody] DTOs.CreateCourseDto dto)
    {
        try
        {
            var userId = Guid.Parse(User.FindFirst(ClaimTypes.NameIdentifier)!.Value);
            var course = await _courseService.CreateAsync(dto, userId);
            return CreatedAtAction(nameof(GetById), new { id = course.Id }, 
                new { message = "Course created successfully", data = course });
        }
        catch (Exception ex)
        {
            return BadRequest(new { message = ex.Message });
        }
    }

    [HttpPatch("{id}")]
    [Authorize(Roles = "Admin")]
    public async Task<IActionResult> Update(Guid id, [FromBody] DTOs.UpdateCourseDto dto)
    {
        try
        {
            var updated = await _courseService.UpdateAsync(id, dto);
            return Ok(new { message = "Course updated successfully", data = updated });
        }
        catch (NotFoundException ex)
        {
            return NotFound(new { message = ex.Message });
        }
    }

    [HttpDelete("{id}")]
    [Authorize(Roles = "Admin")]
    public async Task<IActionResult> Delete(Guid id)
    {
        try
        {
            await _courseService.DeleteAsync(id);
            return Ok(new { message = "Course deleted successfully" });
        }
        catch (NotFoundException ex)
        {
            return NotFound(new { message = ex.Message });
        }
    }

    [HttpGet]
    [AllowAnonymous]
    public async Task<IActionResult> GetAll()
    {
        var courses = await _courseService.GetAllAsync();
        return Ok(new { message = "Courses fetched successfully", data = courses });
    }

    [HttpGet("{id}")]
    public async Task<IActionResult> GetById(Guid id)
    {
        try
        {
            var course = await _courseService.GetByIdAsync(id);
            return Ok(new { message = "Course fetched successfully", data = course });
        }
        catch (NotFoundException ex)
        {
            return NotFound(new { message = ex.Message });
        }
    }
}